rules_version = '2';

// 커뮤니티 로드아웃(sharedLoadouts) 보안 규칙
// - 누구나 읽을 수 있음(공개 갤러리)
// - 새 글 작성(create)은 익명 인증된 사용자만, 이름/데이터 형식·길이 검증
// - 글 내용(name/data/createdAt/ownerId)은 생성 후 절대 수정 불가
// - 좋아요(likedBy)는 "내 uid를 정확히 하나 추가/제거"하는 것만 허용(좋아요/취소 토글)
// - 삭제는 원래 올린 사람(ownerId == 내 uid)만 가능
// 이 파일은 문서 보관용이며, 실제 반영은 Firebase 콘솔 > Firestore Database >
// 규칙(Rules) 탭에 이 내용을 붙여넣고 "게시"를 눌러야 적용됩니다.
// ⚠ Authentication에서 "Anonymous" 로그인 방법이 켜져 있어야 정상 동작합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 운영자 전용 익명 계정의 uid — 이 uid로 로그인한 세션만 reports를 임의로 삭제할 수 있음
    // (운영자가 콘솔에 매번 안 들어가도 스크립트로 스팸/테스트 글을 지울 수 있게 하기 위함)
    function isOperator() {
      return request.auth != null && request.auth.uid == "2S8L0VeihHaUFRkOWOeypEe2Guk1";
    }

    match /sharedLoadouts/{loadoutId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['name', 'data', 'createdAt', 'likedBy', 'ownerId'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.data is string
                    && request.resource.data.data.size() <= 4000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likedBy is list
                    && request.resource.data.likedBy.size() == 0
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                    && request.resource.data.likedBy is list
                    && (
                      // 좋아요: 내 uid를 정확히 하나 추가
                      (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
                       && !resource.data.likedBy.hasAny([request.auth.uid])
                       && request.resource.data.likedBy.hasAll(resource.data.likedBy)
                       && request.resource.data.likedBy.hasAny([request.auth.uid]))
                      ||
                      // 좋아요 취소: 내 uid를 정확히 하나 제거
                      (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
                       && resource.data.likedBy.hasAny([request.auth.uid])
                       && !request.resource.data.likedBy.hasAny([request.auth.uid])
                       && resource.data.likedBy.hasAll(request.resource.data.likedBy))
                    );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // 이용자 신고/건의 (reports) 보안 규칙
    // - 운영자(개발자)가 나중에 확인할 용도라 읽기도 열어둠(별도 관리자 화면 없이 콘솔/스크립트로 조회)
    // - 작성은 익명 인증된 사용자만, 메시지 길이 제한
    // - 내용 수정은 불가하지만, 운영자는 resolved(해결 표시) 필드 하나만 바꿀 수 있음
    // - 삭제는 운영자 계정(isOperator)만 가능(스팸/테스트 글 정리용)
    match /reports/{reportId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['message', 'context', 'userAgent', 'createdAt', 'ownerId'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
                    && request.resource.data.resolved is bool;
      allow delete: if isOperator();

      // 댓글 — 해당 제보를 올린 본인(ownerId 일치)과 운영자만 작성 가능. 읽기는 제보와 마찬가지로 공개.
      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['text', 'createdAt', 'ownerId'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.ownerId == request.auth.uid
                      && (
                        isOperator()
                        || request.auth.uid == get(/databases/$(database)/documents/reports/$(reportId)).data.ownerId
                      );

        allow update: if false;
        allow delete: if isOperator();
      }
    }

    // 무기 평가 — 문서 id 자체가 작성자 uid라서 "무기당 1인 1개"가 구조적으로 강제됨.
    // liked(하트)/text(한줄평)는 독립적(하나 지운다고 다른 게 같이 안 지워짐). 반대(싫어요)
    // 개념 없음 — liked만 집계. agreedBy는 한줄평에 대한 공감(👍)이라 무기 하트와 별개로,
    // 작성자 아닌 사람도 자기 uid만 추가/제거 가능.
    match /weaponReviews/{weaponId}/reviews/{reviewOwnerUid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == reviewOwnerUid
                    && request.resource.data.keys().hasOnly(['liked', 'text', 'agreedBy', 'createdAt', 'ownerId'])
                    && request.resource.data.liked is bool
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.agreedBy is list
                    && request.resource.data.agreedBy.size() == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.ownerId == request.auth.uid;

      // 본인 하트/한줄평 수정
      allow update: if request.auth != null && request.auth.uid == reviewOwnerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked', 'text', 'createdAt'])
                    && request.resource.data.liked is bool
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.createdAt == request.time;

      // 한줄평 공감(👍) — 작성자 포함 누구나 자기 uid를 정확히 하나 추가/제거하는 것만 허용
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreedBy'])
                    && request.resource.data.agreedBy is list
                    && (
                      (request.resource.data.agreedBy.size() == resource.data.agreedBy.size() + 1
                       && !resource.data.agreedBy.hasAny([request.auth.uid])
                       && request.resource.data.agreedBy.hasAll(resource.data.agreedBy)
                       && request.resource.data.agreedBy.hasAny([request.auth.uid]))
                      ||
                      (request.resource.data.agreedBy.size() == resource.data.agreedBy.size() - 1
                       && resource.data.agreedBy.hasAny([request.auth.uid])
                       && !request.resource.data.agreedBy.hasAny([request.auth.uid])
                       && resource.data.agreedBy.hasAll(request.resource.data.agreedBy))
                    );

      allow delete: if request.auth != null && request.auth.uid == reviewOwnerUid;
    }

    // 사무소(매칭 게시판) 이용 등록 — 문서 ID이자 auth uid가 모두 "실제 스팀 로그인(OpenID)으로
    // 검증된 SteamID64"다. 이 uid는 Cloudflare Worker가 스팀에 직접 물어봐서(check_authentication)
    // 로그인이 진짜임을 확인한 뒤에만 Firebase 로그인 토큰으로 발급해주므로, 클라이언트가
    // Firestore에 직접 요청을 보내도 검증 없이는 원하는 SteamID의 uid를 가질 수 없다.
    // - 문서 ID를 SteamID64로 고정해서 "같은 스팀ID로 중복 등록"도 구조적으로 막힘(이미
    //   존재하는 경로에 다시 쓰면 "생성"이 아니라 "수정"으로 취급되고, 아래엔 운영자용
    //   update 규칙만 있어서 자동 거부됨)
    // - 읽기는 본인(ownerId 일치) 또는 운영자만 가능. 문서가 아직 없을 때(!exists())도
    //   허용해야 하는데, 안 그러면 최초 가입자가 "이미 등록됐는지" 확인하려는 읽기 자체가
    //   거부돼서(resource.data가 없어 규칙 평가가 실패) 등록을 시작도 못 하게 된다.
    //   문서가 없을 때 반환되는 정보는 "없음" 하나뿐이라 안전하다.
    // - banned(이용 제한)는 운영자만 켤 수 있음
    match /officeMembers/{steamId} {
      allow read: if request.auth != null
                  && (!exists(/databases/$(database)/documents/officeMembers/$(steamId))
                      || resource.data.ownerId == request.auth.uid
                      || isOperator());

      allow create: if request.auth != null
                    && steamId.matches('^7656119[0-9]{10}$')
                    && request.auth.uid == steamId
                    && request.resource.data.keys().hasOnly(['ownerId', 'pledgeAgreedAt', 'createdAt', 'banned'])
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.pledgeAgreedAt == request.time
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.banned == false;

      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned'])
                    && request.resource.data.banned is bool;

      allow delete: if isOperator();
    }

    // 등록된(=밴 안 된) 사무소 회원인지 — 파티/신청 관련 규칙에서 반복 사용
    function isActiveMember(uid) {
      return exists(/databases/$(database)/documents/officeMembers/$(uid))
          && get(/databases/$(database)/documents/officeMembers/$(uid)).data.banned == false;
    }

    // 파티 모집 정보(활동서버/파티MMR/최소KDA/전투성향/음성여부)가 유효한 형식인지 확인 —
    // create/update 양쪽에서 같이 쓰는 공통 검증
    function isValidPartyFields(d) {
      return d.activeServer is string && d.activeServer.size() > 0 && d.activeServer.size() <= 50
          && d.partyMmr is string && d.partyMmr.size() > 0 && d.partyMmr.size() <= 50
          && d.minKda is string && d.minKda.size() <= 50
          && d.combatStyle is string && d.combatStyle.size() <= 100
          && d.voice is bool;
    }

    // 파티 모집 — 문서 ID = 파티장의 uid(=SteamID64)라서 "한 사람당 활성 파티 1개"가
    // 구조적으로 강제됨. 모집 정보는 사무소 회원이면 누구나 볼 수 있지만, 실제 합류
    // 코드(private/code)와 지원자 목록(applications)은 별도 하위 경로로 분리해서 각각
    // 다른 접근 권한을 준다 — 파티장 본인과, "수락된" 지원자만 코드를 볼 수 있음.
    match /officeParties/{leaderId} {
      allow read: if request.auth != null && isActiveMember(request.auth.uid);

      allow create: if request.auth != null
                    && request.auth.uid == leaderId
                    && isActiveMember(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['leaderId', 'activeServer', 'partyMmr', 'minKda', 'combatStyle', 'voice', 'status', 'createdAt'])
                    && request.resource.data.leaderId == request.auth.uid
                    && isValidPartyFields(request.resource.data)
                    && request.resource.data.status == 'open'
                    && request.resource.data.createdAt == request.time;

      allow update: if request.auth != null && request.auth.uid == leaderId
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeServer', 'partyMmr', 'minKda', 'combatStyle', 'voice', 'status'])
                    && isValidPartyFields(request.resource.data)
                    && request.resource.data.status in ['open', 'closed'];

      allow delete: if request.auth != null && (request.auth.uid == leaderId || isOperator());

      // 합류 코드 — 파티장 본인이거나, 이 파티에 "수락된" 지원자만 읽을 수 있음
      match /private/code {
        allow read: if request.auth != null
                    && (request.auth.uid == leaderId
                        || (exists(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid))
                            && get(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid)).data.status == 'accepted'));

        allow create, update: if request.auth != null && request.auth.uid == leaderId
                      && request.resource.data.keys().hasOnly(['code'])
                      && request.resource.data.code is string
                      && request.resource.data.code.size() > 0
                      && request.resource.data.code.size() <= 100;

        allow delete: if request.auth != null && request.auth.uid == leaderId;
      }

      // 참가 신청 — 문서 ID = 신청자 uid라서 "한 파티에 한 사람당 신청 1개"가 구조적으로 강제됨.
      // 읽기는 신청자 본인과 파티장만. 수락/거절은 파티장만, pending 상태에서만 가능.
      match /applications/{applicantId} {
        allow read: if request.auth != null
                    && (request.auth.uid == applicantId || request.auth.uid == leaderId);

        allow create: if request.auth != null
                      && request.auth.uid == applicantId
                      && applicantId != leaderId
                      && isActiveMember(request.auth.uid)
                      && get(/databases/$(database)/documents/officeParties/$(leaderId)).data.status == 'open'
                      && request.resource.data.keys().hasOnly(['applicantId', 'message', 'status', 'createdAt', 'respondedAt'])
                      && request.resource.data.applicantId == request.auth.uid
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 200
                      && request.resource.data.status == 'pending'
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.respondedAt == null;

        allow update: if request.auth != null && request.auth.uid == leaderId
                      && resource.data.status == 'pending'
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
                      && request.resource.data.status in ['accepted', 'declined']
                      && request.resource.data.respondedAt == request.time;

        allow delete: if request.auth != null && (request.auth.uid == applicantId || request.auth.uid == leaderId);
      }
    }

    // 블라인드 이력서 — 본인과 운영자 외에는 평소엔 아무도 못 읽고, "이 사람이 내 파티에
    // 신청한 경우"에만 그 파티장에게 공개된다(신청 자체가 문서 ID=uid라서 exists()로 확인
    // 가능). 즉 이력서는 이용자 전체에게 공개 게시되는 게 아니라, 실제로 지원했을 때만
    // 해당 파티장에게 "블라인드"로(신원 정보 없이 아래 항목만) 보여지는 구조.
    match /officeResumes/{steamId} {
      allow read: if request.auth != null
                  && (request.auth.uid == steamId
                      || isOperator()
                      || exists(/databases/$(database)/documents/officeParties/$(request.auth.uid)/applications/$(steamId)));

      allow create, update: if request.auth != null
                    && request.auth.uid == steamId
                    && isActiveMember(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['preferredServer', 'mmr', 'kda', 'preferredStyle', 'voice', 'updatedAt'])
                    && request.resource.data.preferredServer is string && request.resource.data.preferredServer.size() <= 50
                    && request.resource.data.mmr is string && request.resource.data.mmr.size() <= 50
                    && request.resource.data.kda is string && request.resource.data.kda.size() <= 50
                    && request.resource.data.preferredStyle is string && request.resource.data.preferredStyle.size() <= 100
                    && request.resource.data.voice is bool
                    && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && (request.auth.uid == steamId || isOperator());
    }
  }
}
