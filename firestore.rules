rules_version = '2';

// 커뮤니티 로드아웃(sharedLoadouts) 보안 규칙
// - 누구나 읽을 수 있음(공개 갤러리)
// - 새 글 작성(create)은 익명 인증된 사용자만, 이름/데이터 형식·길이 검증
// - 글 내용(name/data/createdAt/ownerId)은 생성 후 절대 수정 불가
// - 좋아요(likedBy)는 "내 uid를 정확히 하나 추가/제거"하는 것만 허용(좋아요/취소 토글)
// - 삭제는 원래 올린 사람(ownerId == 내 uid)만 가능
// 이 파일은 문서 보관용이며, 실제 반영은 Firebase 콘솔 > Firestore Database >
// 규칙(Rules) 탭에 이 내용을 붙여넣고 "게시"를 눌러야 적용됩니다.
// ⚠ Authentication에서 "Anonymous" 로그인 방법이 켜져 있어야 정상 동작합니다.
service cloud.firestore {
  match /databases/{database}/documents {
    // 운영자 전용 익명 계정의 uid — 이 uid로 로그인한 세션만 reports를 임의로 삭제할 수 있음
    // (운영자가 콘솔에 매번 안 들어가도 스크립트로 스팸/테스트 글을 지울 수 있게 하기 위함)
    function isOperator() {
      return request.auth != null && request.auth.uid == "2S8L0VeihHaUFRkOWOeypEe2Guk1";
    }

    match /sharedLoadouts/{loadoutId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['name', 'data', 'createdAt', 'likedBy', 'ownerId'])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 30
                    && request.resource.data.data is string
                    && request.resource.data.data.size() <= 4000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.likedBy is list
                    && request.resource.data.likedBy.size() == 0
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy'])
                    && request.resource.data.likedBy is list
                    && (
                      // 좋아요: 내 uid를 정확히 하나 추가
                      (request.resource.data.likedBy.size() == resource.data.likedBy.size() + 1
                       && !resource.data.likedBy.hasAny([request.auth.uid])
                       && request.resource.data.likedBy.hasAll(resource.data.likedBy)
                       && request.resource.data.likedBy.hasAny([request.auth.uid]))
                      ||
                      // 좋아요 취소: 내 uid를 정확히 하나 제거
                      (request.resource.data.likedBy.size() == resource.data.likedBy.size() - 1
                       && resource.data.likedBy.hasAny([request.auth.uid])
                       && !request.resource.data.likedBy.hasAny([request.auth.uid])
                       && resource.data.likedBy.hasAll(request.resource.data.likedBy))
                    );

      allow delete: if request.auth != null && request.auth.uid == resource.data.ownerId;
    }

    // 이용자 신고/건의 (reports) 보안 규칙
    // - 운영자(개발자)가 나중에 확인할 용도라 읽기도 열어둠(별도 관리자 화면 없이 콘솔/스크립트로 조회)
    // - 작성은 익명 인증된 사용자만, 메시지 길이 제한
    // - 내용 수정은 불가하지만, 운영자는 resolved(해결 표시) 필드 하나만 바꿀 수 있음
    // - 삭제는 운영자 계정(isOperator)만 가능(스팸/테스트 글 정리용)
    match /reports/{reportId} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.resource.data.keys().hasOnly(['message', 'context', 'userAgent', 'createdAt', 'ownerId'])
                    && request.resource.data.message is string
                    && request.resource.data.message.size() > 0
                    && request.resource.data.message.size() <= 1000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.ownerId == request.auth.uid;

      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved'])
                    && request.resource.data.resolved is bool;
      allow delete: if isOperator();

      // 댓글 — 해당 제보를 올린 본인(ownerId 일치)과 운영자만 작성 가능. 읽기는 제보와 마찬가지로 공개.
      match /comments/{commentId} {
        allow read: if true;

        allow create: if request.auth != null
                      && request.resource.data.keys().hasOnly(['text', 'createdAt', 'ownerId'])
                      && request.resource.data.text is string
                      && request.resource.data.text.size() > 0
                      && request.resource.data.text.size() <= 500
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.ownerId == request.auth.uid
                      && (
                        isOperator()
                        || request.auth.uid == get(/databases/$(database)/documents/reports/$(reportId)).data.ownerId
                      );

        allow update: if false;
        allow delete: if isOperator();
      }
    }

    // 무기 평가 — 문서 id 자체가 작성자 uid라서 "무기당 1인 1개"가 구조적으로 강제됨.
    // liked(하트)/text(한줄평)는 독립적(하나 지운다고 다른 게 같이 안 지워짐). 반대(싫어요)
    // 개념 없음 — liked만 집계. agreedBy는 한줄평에 대한 공감(👍)이라 무기 하트와 별개로,
    // 작성자 아닌 사람도 자기 uid만 추가/제거 가능.
    match /weaponReviews/{weaponId}/reviews/{reviewOwnerUid} {
      allow read: if true;

      allow create: if request.auth != null
                    && request.auth.uid == reviewOwnerUid
                    && request.resource.data.keys().hasOnly(['liked', 'text', 'agreedBy', 'createdAt', 'ownerId'])
                    && request.resource.data.liked is bool
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.agreedBy is list
                    && request.resource.data.agreedBy.size() == 0
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.ownerId == request.auth.uid;

      // 본인 하트/한줄평 수정
      allow update: if request.auth != null && request.auth.uid == reviewOwnerUid
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['liked', 'text', 'createdAt'])
                    && request.resource.data.liked is bool
                    && request.resource.data.text is string
                    && request.resource.data.text.size() <= 300
                    && request.resource.data.createdAt == request.time;

      // 한줄평 공감(👍) — 작성자 포함 누구나 자기 uid를 정확히 하나 추가/제거하는 것만 허용
      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['agreedBy'])
                    && request.resource.data.agreedBy is list
                    && (
                      (request.resource.data.agreedBy.size() == resource.data.agreedBy.size() + 1
                       && !resource.data.agreedBy.hasAny([request.auth.uid])
                       && request.resource.data.agreedBy.hasAll(resource.data.agreedBy)
                       && request.resource.data.agreedBy.hasAny([request.auth.uid]))
                      ||
                      (request.resource.data.agreedBy.size() == resource.data.agreedBy.size() - 1
                       && resource.data.agreedBy.hasAny([request.auth.uid])
                       && !request.resource.data.agreedBy.hasAny([request.auth.uid])
                       && resource.data.agreedBy.hasAll(request.resource.data.agreedBy))
                    );

      allow delete: if request.auth != null && request.auth.uid == reviewOwnerUid;
    }

    // 맵 탭 지점/범례 — 운영자가 지도에서 클릭해 지점을 찍고 "확정"을 누르면 여기 저장돼
    // 모든 방문자에게 그대로 보인다. 읽기는 로그인 여부와 무관하게 전체 공개(비회원도
    // 지도 탭을 봐야 하므로), 쓰기는 운영자만.
    match /mapOverrides/{mapId} {
      allow read: if true;
      allow create, update: if isOperator()
                    && request.resource.data.keys().hasOnly(['points'])
                    && request.resource.data.points is map;
      allow delete: if isOperator();
    }
    match /mapCustomLayers/{docId} {
      allow read: if true;
      allow create, update: if isOperator()
                    && request.resource.data.keys().hasOnly(['layers'])
                    && request.resource.data.layers is list;
      allow delete: if isOperator();
    }

    // 사무소(매칭 게시판) 이용 등록 — 문서 ID이자 auth uid가 모두 "실제 스팀 로그인(OpenID)으로
    // 검증된 SteamID64"다. 이 uid는 Cloudflare Worker가 스팀에 직접 물어봐서(check_authentication)
    // 로그인이 진짜임을 확인한 뒤에만 Firebase 로그인 토큰으로 발급해주므로, 클라이언트가
    // Firestore에 직접 요청을 보내도 검증 없이는 원하는 SteamID의 uid를 가질 수 없다.
    // - 문서 ID를 SteamID64로 고정해서 "같은 스팀ID로 중복 등록"도 구조적으로 막힘(이미
    //   존재하는 경로에 다시 쓰면 "생성"이 아니라 "수정"으로 취급되고, 아래엔 운영자용
    //   update 규칙만 있어서 자동 거부됨)
    // - 읽기는 본인(ownerId 일치) 또는 운영자만 가능. 문서가 아직 없을 때(!exists())도
    //   허용해야 하는데, 안 그러면 최초 가입자가 "이미 등록됐는지" 확인하려는 읽기 자체가
    //   거부돼서(resource.data가 없어 규칙 평가가 실패) 등록을 시작도 못 하게 된다.
    //   문서가 없을 때 반환되는 정보는 "없음" 하나뿐이라 안전하다.
    // - banned(이용 제한)는 운영자만 켤 수 있음
    match /officeMembers/{steamId} {
      allow read: if request.auth != null
                  && (!exists(/databases/$(database)/documents/officeMembers/$(steamId))
                      || resource.data.ownerId == request.auth.uid
                      || isOperator());

      allow create: if request.auth != null
                    && steamId.matches('^7656119[0-9]{10}$')
                    && request.auth.uid == steamId
                    && request.resource.data.keys().hasOnly(['ownerId', 'pledgeAgreedAt', 'createdAt', 'banned'])
                    && request.resource.data.ownerId == request.auth.uid
                    && request.resource.data.pledgeAgreedAt == request.time
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.banned == false;

      // banned: 영구 차단 여부. bannedUntil: 기간제 차단 만료 시각(null이면 기간제 차단
      // 없음) — 운영자가 밴 처리할 때 이 둘을 항상 같이 써서 의도를 명확히 한다
      // (예: 7일 차단 -> {banned:false, bannedUntil:7일 뒤}, 영구 -> {banned:true,
      // bannedUntil:null}, 해제 -> {banned:false, bannedUntil:null}). 기간이 지나면
      // isCurrentlyBanned()가 자동으로 차단 아님으로 판정하므로 별도 해제 작업 불필요.
      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['banned', 'bannedUntil'])
                    && request.resource.data.banned is bool
                    && (request.resource.data.bannedUntil == null || request.resource.data.bannedUntil is timestamp);

      // 본인이 등록한 스팀 ID는 스스로도 지울 수 있음(사무소 탈퇴)
      allow delete: if isOperator() || (request.auth != null && request.auth.uid == steamId);
    }

    // 등록된(=밴 안 된) 사무소 회원인지 — 파티/신청 관련 규칙에서 반복 사용
    // 영구 차단(banned)이거나, 기간제 차단(bannedUntil)이 아직 안 끝났으면 차단 상태로 본다.
    // bannedUntil 필드가 아예 없는(과거) 문서도 안전하게 처리되도록 먼저 존재를 확인한다.
    function isCurrentlyBanned(memberData) {
      return memberData.banned == true
          || (('bannedUntil' in memberData) && memberData.bannedUntil != null && memberData.bannedUntil > request.time);
    }

    function isActiveMember(uid) {
      return exists(/databases/$(database)/documents/officeMembers/$(uid))
          && !isCurrentlyBanned(get(/databases/$(database)/documents/officeMembers/$(uid)).data);
    }

    // 헌트 서버 지역 — 파티 활동서버/프로필 선호 서버 둘 다 복수 선택 가능, "상관없음"도
    // 값으로 허용. 최소 1개는 골라야 함
    function isValidServerPreferenceList(list) {
      return list is list
          && list.size() > 0
          && list.size() <= 8
          && list.hasOnly(['유럽', '러시아', '미국서부', '미국동부', '남미', '아시아', '오세아니아', '상관없음']);
    }

    // 파티 인원 유형(듀오/트리오) — 파티 게시글과 이력서(선호 인원) 둘 다 이 목록 중 하나
    function isValidPartyType(t) {
      return t in ['듀오', '트리오'];
    }

    // 듀오/트리오별 최대 인원(리더 포함) — 구인 게시판 인원수 표시, acceptedCount 상한 검증에 씀
    function partyMaxSize(t) {
      return t == '트리오' ? 3 : 2;
    }

    // 게임 모드(결전/사냥/상관없음) — 파티 게시글과 프로필(선호 모드) 둘 다 이 목록 중 하나
    function isValidGameMode(m) {
      return m in ['결전', '사냥', '상관없음'];
    }

    // 파티 모집 정보(활동서버/파티MMR/최소KDA/전투성향/음성여부/코드공개여부/유형/모드)가
    // 유효한 형식인지 확인 — create/update 양쪽에서 같이 쓰는 공통 검증
    function isValidPartyFields(d) {
      return isValidServerPreferenceList(d.activeServers)
          && d.partyMmr is string && d.partyMmr.size() > 0 && d.partyMmr.size() <= 50
          && d.minKda is string && d.minKda.size() <= 50
          && d.combatStyle is string && d.combatStyle.size() <= 100
          && d.voice is bool
          && d.codePublic is bool
          && isValidPartyType(d.partyType)
          && isValidGameMode(d.gameMode);
    }

    // 파티 모집 — 문서 ID = 파티장의 uid(=SteamID64)라서 "한 사람당 활성 파티 1개"가
    // 구조적으로 강제됨. 모집 정보는 사무소 회원이면 누구나 볼 수 있지만, 실제 합류
    // 코드(private/code)와 지원자 목록(applications)은 별도 하위 경로로 분리해서 각각
    // 다른 접근 권한을 준다 — 파티장 본인과, "수락된" 지원자(또는 codePublic이면 회원 전체)만
    // 코드를 볼 수 있음.
    match /officeParties/{leaderId} {
      // 운영자는 스팀 인증(officeMembers 등록) 없이도 열람만 할 수 있음 — 쓰기 권한은
      // 아래 create/update 어디에도 isOperator() 예외가 없으므로 여전히 막혀 있다.
      allow read: if request.auth != null && (isActiveMember(request.auth.uid) || isOperator());

      allow create: if request.auth != null
                    && request.auth.uid == leaderId
                    && isActiveMember(request.auth.uid)
                    // 파티원이 파티장을 식별할 수 있으려면 파티장도 등록번호(이력서)가
                    // 있어야 해서, 파티를 만들려면 먼저 이력서를 등록해야 한다.
                    && exists(/databases/$(database)/documents/officeResumes/$(request.auth.uid))
                    && request.resource.data.keys().hasOnly(['leaderId', 'activeServers', 'partyMmr', 'minKda', 'combatStyle', 'voice', 'codePublic', 'status', 'createdAt', 'renewedAt', 'partyType', 'gameMode', 'acceptedCount', 'partyNumber'])
                    && request.resource.data.leaderId == request.auth.uid
                    && isValidPartyFields(request.resource.data)
                    && request.resource.data.status == 'open'
                    && request.resource.data.acceptedCount == 0
                    && request.resource.data.partyNumber is string
                    && request.resource.data.partyNumber.matches('^[0-9]{8}$')
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.renewedAt == request.time;

      // 수정은 다섯 갈래: (1) 파티장이 모집 정보/상태를 고치는 일반 수정 — acceptedCount는
      // 그대로 유지돼야 함(renewedAt은 건드려도 되고 안 건드려도 되는데, 건드리면 반드시
      // 지금 시각이어야 함 — 3시간 만료 타이머를 "등록/수정"이나 "타이머 리셋" 버튼으로
      // 갱신하는 용도). (2) acceptedCount만 정확히 1 늘거나(신청 수락, 최대 인원을
      // 넘을 수 없다) (3) 1 줄어드는 것(파티원 내보내기) — 이 셋은 파티장만. (4) 내가
      // 받은 초대(invited)를 내가 수락하면서 acceptedCount를 내 몫만큼 1 늘리는 것 —
      // 초대받은 본인만. (5) 내가 이미 수락된(accepted) 파티원인 상태에서 acceptedCount를
      // 내 몫만큼 1 줄이는 것 — 파티 나가기(leaveParty), 파티원 본인만.
      allow update: if request.auth != null
                    && (
                      (request.auth.uid == leaderId
                       && (
                            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['activeServers', 'partyMmr', 'minKda', 'combatStyle', 'voice', 'codePublic', 'status', 'partyType', 'gameMode', 'renewedAt'])
                             && isValidPartyFields(request.resource.data)
                             && request.resource.data.status in ['open', 'closed']
                             && request.resource.data.acceptedCount == resource.data.acceptedCount
                             && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['renewedAt']) || request.resource.data.renewedAt == request.time))
                            ||
                            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCount'])
                             && request.resource.data.acceptedCount == resource.data.acceptedCount + 1
                             && request.resource.data.acceptedCount <= partyMaxSize(resource.data.partyType))
                            ||
                            (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCount'])
                             && request.resource.data.acceptedCount == resource.data.acceptedCount - 1
                             && request.resource.data.acceptedCount >= 0)
                          ))
                      ||
                      (request.auth.uid != leaderId
                       && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['acceptedCount'])
                       && exists(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid))
                       && (
                            (request.resource.data.acceptedCount == resource.data.acceptedCount + 1
                             && request.resource.data.acceptedCount <= partyMaxSize(resource.data.partyType)
                             && get(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid)).data.status == 'invited')
                            ||
                            (request.resource.data.acceptedCount == resource.data.acceptedCount - 1
                             && request.resource.data.acceptedCount >= 0
                             && get(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid)).data.status == 'accepted')
                          ))
                    );

      allow delete: if request.auth != null && (request.auth.uid == leaderId || isOperator());

      // 합류 코드(숫자 6자리) — 파티장 본인이거나, 신청/초대 어느 경로로 왔든 최종적으로
      // "참가 승인(accepted)"된 사람만 읽을 수 있음. 초대만 받고 아직 수락 전이거나,
      // 신청만 하고 아직 대기 중인 사람에게는 보이지 않는다.
      match /private/code {
        allow read: if request.auth != null
                    && (request.auth.uid == leaderId
                        || (exists(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid))
                            && get(/databases/$(database)/documents/officeParties/$(leaderId)/applications/$(request.auth.uid)).data.status == 'accepted'));

        allow create, update: if request.auth != null && request.auth.uid == leaderId
                      && request.resource.data.keys().hasOnly(['code'])
                      && request.resource.data.code is string
                      && request.resource.data.code.matches('^[0-9]{6}$');

        allow delete: if request.auth != null && request.auth.uid == leaderId;
      }

      // 참가 신청/초대 — 문서 ID = 상대방(신청자 또는 초대받은 사람) uid라서 "한 파티에
      // 한 사람당 관계 1개"가 구조적으로 강제됨. 읽기는 그 상대방 본인과 파티장만.
      // 두 가지 시작 경로가 있음: (1) 회원이 직접 신청(status: pending) — 본인 프로필이
      // 등록돼 있어야 하고(officeResumes 존재), 파티장이 수락/거절. (2) 파티장이 프로필
      // 게시판을 보고 먼저 초대(status: invited) — 초대받은 본인이 수락/거절. 이미
      // 수락된 신청은 파티장이 kicked로 바꿔서 내보낼 수 있음(officeParties의
      // acceptedCount -1과 같은 배치로 처리 — firebase-init.js kickApplicant 참고).
      // 수락 시엔 반대로 +1(respondToApplication/respondToInvite 참고).
      match /applications/{applicantId} {
        allow read: if request.auth != null
                    && (request.auth.uid == applicantId || request.auth.uid == leaderId);

        allow create: if request.auth != null
                      && applicantId != leaderId
                      && request.resource.data.keys().hasOnly(['applicantId', 'message', 'status', 'createdAt', 'respondedAt'])
                      && request.resource.data.applicantId == applicantId
                      && request.resource.data.message is string
                      && request.resource.data.message.size() <= 200
                      && request.resource.data.createdAt == request.time
                      && request.resource.data.respondedAt == null
                      && (
                        (request.auth.uid == applicantId
                         && isActiveMember(request.auth.uid)
                         && exists(/databases/$(database)/documents/officeResumes/$(request.auth.uid))
                         && get(/databases/$(database)/documents/officeParties/$(leaderId)).data.status == 'open'
                         && request.resource.data.status == 'pending')
                        ||
                        (request.auth.uid == leaderId
                         && isActiveMember(applicantId)
                         && request.resource.data.status == 'invited')
                      );

        allow update: if request.auth != null
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'respondedAt'])
                      && request.resource.data.respondedAt == request.time
                      && (
                        (request.auth.uid == leaderId
                         && (
                              (resource.data.status == 'pending' && request.resource.data.status in ['accepted', 'declined'])
                              || (resource.data.status == 'accepted' && request.resource.data.status == 'kicked')
                            ))
                        ||
                        (request.auth.uid == applicantId
                         && resource.data.status == 'invited'
                         && request.resource.data.status in ['accepted', 'declined'])
                      );

        allow delete: if request.auth != null && (request.auth.uid == applicantId || request.auth.uid == leaderId);
      }
    }

    // 이력서("인력 목록") — 사무소 회원이면 누구나 목록으로 읽을 수 있다. 문서 자체엔
    // steamId 등 신원 정보를 담지 않아서(문서 ID가 곧 steamId이긴 하지만, 화면에는
    // 절대 그 값을 노출하지 않는 게 클라이언트 쪽 원칙) "블라인드"가 유지된다.
    // 파티장이 되려면 먼저 이 이력서가 있어야 등록번호(resumeNumber)가 생기므로,
    // 파티장도 이력서를 계속 갖고 있을 수 있게 한다(다만 목록 화면에서는 파티장인
    // 동안은 클라이언트가 걸러서 안 보여준다 — app.js renderResumeList 참고).
    match /officeResumes/{steamId} {
      // 운영자는 스팀 인증 없이도 열람만 가능 — 쓰기(create/update)는 여전히
      // isActiveMember(officeMembers 등록)만 허용하므로 운영자는 프로필을 등록할 수 없다.
      allow read: if request.auth != null && (isActiveMember(request.auth.uid) || isOperator());

      allow create, update: if request.auth != null
                    && request.auth.uid == steamId
                    && isActiveMember(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['preferredServers', 'mmr', 'kda', 'preferredStyle', 'voice', 'updatedAt', 'preferredPartyType', 'preferredGameMode', 'resumeNumber'])
                    && isValidServerPreferenceList(request.resource.data.preferredServers)
                    && request.resource.data.mmr is string && request.resource.data.mmr.size() <= 50
                    && request.resource.data.kda is string && request.resource.data.kda.size() <= 50
                    && request.resource.data.preferredStyle is string && request.resource.data.preferredStyle.size() <= 100
                    && request.resource.data.voice is bool
                    && isValidPartyType(request.resource.data.preferredPartyType)
                    && isValidGameMode(request.resource.data.preferredGameMode)
                    && request.resource.data.resumeNumber is string
                    && request.resource.data.resumeNumber.matches('^[0-9]{9}$')
                    && request.resource.data.updatedAt == request.time;

      allow delete: if request.auth != null && (request.auth.uid == steamId || isOperator());
    }

    // 등록번호(memberNumber) 영구 등록부 — "이 번호는 언제 누구(steamId)에게 배정됐는가"를
    // 절대 지워지지 않게 기록한다. 이력서(officeResumes.resumeNumber)는 재등록하면 새
    // 번호로 바뀔 수 있지만, 예전에 쓰던 번호도 신고 처리 때 "그때 그 번호가 누구였는지"
    // 조회할 수 있어야 하므로 별도로 영구 보관한다. 문서 ID = 번호 자체라서, 이미 다른
    // 사람이 그 번호로 먼저 문서를 만들어놨으면(update 권한이 없으므로) 새로 못 만든다 —
    // 그래서 클라이언트는 무작위로 번호를 생성했다가 이 규칙에 막히면 다른 번호로
    // 재시도하는 방식으로 충돌을 피한다.
    match /officeMemberNumberHistory/{memberNumber} {
      allow read: if isOperator();
      allow create: if request.auth != null
                    && memberNumber.matches('^[0-9]{9}$')
                    && request.resource.data.keys().hasOnly(['steamId', 'assignedAt'])
                    && request.resource.data.steamId == request.auth.uid
                    && request.resource.data.assignedAt == request.time;
      allow update, delete: if false;
    }

    // 파티 로스터(가명 번호만) — "최근 기록" 화면에서 본인이 참여했던 파티에 그때 당시
    // 같이 있었던 사람들을 가명 번호(memberNumber)로만 보여주기 위한 용도. 진짜 스팀ID는
    // 여기 전혀 담기지 않는다(그건 officePartyHistory에만, 본인·운영자만 열람). 그 파티에
    // 실제로 있었던(officePartyHistory에 자기 행이 있는) 사람만 이 문서를 읽을 수 있다.
    match /officePartyRoster/{partyNumber} {
      allow read: if request.auth != null
                  && (isOperator()
                      || exists(/databases/$(database)/documents/officePartyHistory/$(partyNumber + '_' + request.auth.uid)));

      allow create: if request.auth != null
                    && partyNumber.matches('^[0-9]{8}$')
                    && request.resource.data.keys().hasOnly(['leaderId', 'members', 'expireAt'])
                    && request.resource.data.leaderId == request.auth.uid
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == 1
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt >= request.time + duration.value(71, 'h');

      // 파티원이 수락될 때 자기 항목을 추가 — 파티장 본인이거나(파티장이 수락 처리할
      // 때), 초대받은 본인이 직접 수락할 때 둘 다 쓸 수 있어야 하므로 활성 회원이면
      // 허용하고, 개수가 정확히 1개만 늘어나는 것으로 실제 조작 범위를 제한한다.
      // hasAll(기존 members)까지 확인해서, 기존에 있던 항목을 다른 내용으로
      // 바꿔치기하거나 지우는 건 막고 "새 항목 하나 추가"만 되게 한다.
      allow update: if request.auth != null && isActiveMember(request.auth.uid)
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
                    && request.resource.data.members is list
                    && request.resource.data.members.size() == resource.data.members.size() + 1
                    && request.resource.data.members.hasAll(resource.data.members);
    }

    // 파티 번호 발급용 일자별 카운터 — 문서 ID는 YYMMDD(6자리). 트랜잭션으로
    // 읽고 +1해서 쓰므로 동시에 여러 파티가 생성돼도 번호가 겹치지 않는다.
    match /officePartyDayCounters/{dayKey} {
      allow read: if request.auth != null && isActiveMember(request.auth.uid);
      allow create: if request.auth != null && isActiveMember(request.auth.uid)
                    && dayKey.matches('^[0-9]{6}$')
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == 1;
      allow update: if request.auth != null && isActiveMember(request.auth.uid)
                    && request.resource.data.keys().hasOnly(['count'])
                    && request.resource.data.count == resource.data.count + 1;
    }

    // 파티 참여 이력(운영자 전용 열람) — officeParties/applications는 파티가 끝나면
    // 지워지지만, 이 컬렉션은 "누가 어느 파티 번호에 언제 들어와서 언제 나갔는지"를
    // 영구적으로 남겨둔다. 문서 ID를 "{partyNumber}_{steamId}"로 고정해서, 신고
    // 접수 시 "신고자가 정말 그 파티에 있었는가"를 규칙에서 exists()로 바로 검증할
    // 수 있게 한다(officeReports.create 참고). 신고 처리 시엔 운영자가 같은 partyNumber로
    // 조회해서 그 파티에 실제로 있었던 사람(스팀ID)들을 확인한다.
    match /officePartyHistory/{historyId} {
      allow read: if request.auth != null && (resource.data.steamId == request.auth.uid || isOperator());

      allow create: if request.auth != null
                    && historyId == request.resource.data.partyNumber + '_' + request.resource.data.steamId
                    && request.resource.data.keys().hasOnly(['steamId', 'partyNumber', 'leaderId', 'role', 'joinedAt', 'leftAt', 'memberNumberAtJoin', 'expireAt'])
                    && request.resource.data.steamId is string
                    && request.resource.data.partyNumber is string
                    && request.resource.data.partyNumber.matches('^[0-9]{8}$')
                    && request.resource.data.leaderId is string
                    && request.resource.data.role in ['leader', 'member']
                    && request.resource.data.memberNumberAtJoin is string
                    && request.resource.data.memberNumberAtJoin.matches('^[0-9]{9}$')
                    && request.resource.data.joinedAt == request.time
                    && request.resource.data.leftAt == null
                    && request.resource.data.expireAt is timestamp
                    && request.resource.data.expireAt >= request.time + duration.value(71, 'h')
                    && (
                         (request.resource.data.role == 'leader'
                          && request.auth.uid == request.resource.data.steamId
                          && request.auth.uid == request.resource.data.leaderId)
                         ||
                         (request.resource.data.role == 'member'
                          && (request.auth.uid == request.resource.data.leaderId || request.auth.uid == request.resource.data.steamId))
                       );

      allow update: if request.auth != null
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leftAt'])
                    && request.resource.data.leftAt == request.time
                    && (request.auth.uid == resource.data.steamId || request.auth.uid == resource.data.leaderId || isOperator());

      allow delete: if isOperator();
    }

    // 사무소 위반 신고 — 영상/설명은 신고한 본인과 운영자만 볼 수 있다(전체공개 아님).
    // 문서 ID는 자동 생성(한 사람이 여러 건 신고 가능). list 조회는 규칙상 정확히
    // reporterId==내 uid로 where 필터를 건 쿼리만 통과되고(그 외엔 거부), 운영자는
    // resource.data와 무관하게 항상 true라 필터 없이도 전체 조회 가능(REST로 처리 —
    // firebase-init.js listMyOfficeReports / app.js listOfficeReportsAsOperator 참고).
    // 처리(resolved)·보류(keep, 1주일 자동삭제 방지)는 운영자만 바꿀 수 있고, 삭제도
    // 운영자만 가능(자동삭제도 운영자 세션에서 REST로 수행).
    //
    // incidentPartyNumber(파티번호) + targetMemberNumber(신고 대상의 영구
    // 등록번호)로 신고를 받는다. "신고자가 정말 그 파티에 있었는지"와 "지목한 등록번호의
    // 주인도 정말 같은 파티에 있었는지"를 규칙에서 이중으로 강제한다 — 번호를 잘못
    // 입력해도(오타) 두 조건이 우연히 동시에 맞아떨어질 확률이 극히 낮아서 사실상 걸러진다.
    // targetMemberNumber → 실제 스팀ID 변환은 officeMemberNumberHistory(영구 기록)로
    // 하기 때문에, 그 사람이 나중에 이력서를 재등록해서 새 번호를 받아도 예전 신고 기록의
    // 정확성에는 영향이 없다. 실제로 규칙을 위반했는지는 시스템이 아니라 운영자가 영상을
    // 보고 판단해야 하는 영역이라 규칙으로 검증하지 않는다.
    match /officeReports/{reportId} {
      allow read: if request.auth != null
                  && (resource.data.reporterId == request.auth.uid || isOperator());

      // 운영자는 스팀 로그인(officeMembers 등록) 없이도, 실제 파티 참여 이력 없이도
      // 신고 기능을 테스트할 수 있어야 해서 이 규칙 전체에 isOperator() 예외를 둠
      allow create: if request.auth != null
                    && (isActiveMember(request.auth.uid) || isOperator())
                    && request.resource.data.keys().hasOnly(['reporterId', 'description', 'videoUrl', 'createdAt', 'resolved', 'keep', 'incidentPartyNumber', 'targetMemberNumber'])
                    && request.resource.data.reporterId == request.auth.uid
                    && request.resource.data.description is string
                    && request.resource.data.description.size() <= 200
                    && request.resource.data.videoUrl is string
                    && request.resource.data.videoUrl.size() > 0
                    && request.resource.data.videoUrl.size() <= 1000
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.resolved == false
                    && request.resource.data.keep == false
                    && request.resource.data.incidentPartyNumber is string
                    && request.resource.data.incidentPartyNumber.matches('^[0-9]{8}$')
                    && request.resource.data.targetMemberNumber is string
                    && request.resource.data.targetMemberNumber.matches('^[0-9]{9}$')
                    && (isOperator()
                        || (exists(/databases/$(database)/documents/officePartyHistory/$(request.resource.data.incidentPartyNumber + '_' + request.auth.uid))
                            && exists(/databases/$(database)/documents/officeMemberNumberHistory/$(request.resource.data.targetMemberNumber))
                            && exists(/databases/$(database)/documents/officePartyHistory/$(request.resource.data.incidentPartyNumber + '_' + get(/databases/$(database)/documents/officeMemberNumberHistory/$(request.resource.data.targetMemberNumber)).data.steamId))));

      allow update: if isOperator()
                    && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['resolved', 'keep'])
                    && request.resource.data.resolved is bool
                    && request.resource.data.keep is bool;

      allow delete: if isOperator();
    }
  }
}
