rules_version = '2';

// 사무소 신고 첨부 영상(Cloud Storage) 보안 규칙
// - 경로 자체에 신고자 uid가 들어가 있어 본인 경로에만 올릴 수 있음(구조적 강제)
// - 읽기는 신고자 본인과 운영자만(전체공개 아님) — Firestore의 officeReports 규칙과 동일한 방침
// - 이 파일은 문서 보관용이며, 실제 반영은 Firebase 콘솔 > Storage > Rules 탭에
//   이 내용을 붙여넣고 "게시"를 눌러야 적용됩니다.
service firebase.storage {
  match /b/{bucket}/o {
    // firestore.rules의 isOperator()와 동일한 운영자 전용 익명 계정 uid
    function isOperator() {
      return request.auth != null && request.auth.uid == "2S8L0VeihHaUFRkOWOeypEe2Guk1";
    }

    match /officeReportVideos/{reporterId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == reporterId || isOperator());

      allow write: if request.auth != null && request.auth.uid == reporterId
                   && request.resource.size < 150 * 1024 * 1024
                   && request.resource.contentType.matches('video/.*');

      allow delete: if request.auth != null && (request.auth.uid == reporterId || isOperator());
    }
  }
}
